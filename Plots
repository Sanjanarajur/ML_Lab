#3d surface
import numpy as np
import matplotlib.pyplot as plt
X = np.linspace(1,5,10)
Y = np.linspace(1,5,10)
X,Y = np.meshgrid(X,Y)
Z = X*Y
fig = plt.figure()
ax= fig.add_subplot(111,projection="3d")
ax.plot_surface(X,Y,Z)
plt.title("3d surface")
plt.show()
