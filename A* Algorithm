import heapq
def a_star(graph, start, goal, heuristic):
    pq = [(heuristic[start], 0, start)]
    parent = {start: None}
    cost = {start: 0}
    while pq:
        _, g, current = heapq.heappop(pq)
        if current == goal:
            break
        for neighbor, w in graph[current]:
            new_g = g + w
            if neighbor not in cost or new_g < cost[neighbor]:
                cost[neighbor] = new_g
                f = new_g + heuristic[neighbor]
                heapq.heappush(pq, (f, new_g, neighbor))
                parent[neighbor] = current
    path = []
    node = goal
    while node is not None:
        path.append(node)
        node = parent[node]
    return path[::-1]
graph = {
    'A': [('B',1), ('C',3)],
    'B': [('D',2), ('E',1)],
    'C': [('F',5), ('G',2)],
    'D': [],
    'E': [],
    'F': [],
    'G': []
}
heuristic = {
    'A': 6,
    'B': 4,
    'C': 4,
    'D': 0,
    'E': 2,
    'F': 3,
    'G': 1
}
print(a_star(graph, 'A', 'D', heuristic))
