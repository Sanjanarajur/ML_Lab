import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import accuracy_score
# Load dataset
data = pd.read_csv("glass.csv")
X = data.drop("Type", axis=1)
y = data["Type"]
for test_size in [0.1, 0.3]:      # 90:10 and 70:30
    for k in [3, 5]:              # K=3 and K=5
        X_train, X_test, y_train, y_test = train_test_split(
            X, y, test_size=test_size, random_state=42)
        # Euclidean Distance
        model = KNeighborsClassifier(n_neighbors=k, metric='euclidean')
        model.fit(X_train, y_train)
        pred = model.predict(X_test)
        print(f"\nK={k}, Split={(1-test_size)*100:.0f}-{test_size*100:.0f}")
        print("Euclidean Accuracy:",
              accuracy_score(y_test, pred))
        # Manhattan Distance
        model = KNeighborsClassifier(n_neighbors=k, metric='manhattan')
        model.fit(X_train, y_train)
        pred = model.predict(X_test)
        print("Manhattan Accuracy:",
              accuracy_score(y_test, pred))
